{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "领域资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "facts",
    "sample_id",
    "collection_principle",
    "collected_data",
    "triage_paths",
    "retention_rules",
    "boundary_materials",
    "traceable_events",
    "safeguards"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "collection_principle": {
      "type": "string",
      "minLength": 1
    },
    "collected_data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/codeLabel"
      }
    },
    "triage_paths": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["code", "label", "path"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "retention_rules": {
      "type": "object",
      "required": ["raw_content", "necessary_summary", "rule_versions"],
      "properties": {
        "raw_content": { "type": "string", "minLength": 1 },
        "necessary_summary": { "type": "string", "minLength": 1 },
        "rule_versions": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "boundary_materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "label", "purpose"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "traceable_events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/codeLabel" }
    },
    "safeguards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "statement"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "codeLabel": {
      "type": "object",
      "required": ["code", "label"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
